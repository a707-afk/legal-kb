# 法律合规知识库 —— 环境配置模板
# 复制为 .env 后按需修改。.env 不入版本库。

# ---------- 应用 ----------
APP_NAME=legal-kb
DEBUG=true

# ---------- 向量库（Qdrant，Docker）----------
# 注意：用 18333 而非 16333 —— 16333 落在 Windows 保留端口段
QDRANT_URL=http://localhost:18333
QDRANT_COLLECTION_NAME=legal_kb_m3

# ---------- 嵌入 / 重排（本地，零网络）----------
# 加载后会校验维度 == 集合维度，不匹配直接抛错（不再静默回退）
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=1024
INFERENCE_DEVICE=auto

# ---------- 语料 ----------
DOCS_DIR=data/docs
BM25_CORPUS_PATH=data/docs
BM25_DICT_PATH=data/dict/legal_terms.txt

# ---------- 检索 ----------
HYBRID_BM25_ENABLED=true
HYBRID_FUSION=rrf
BM25_CANDIDATE_TOP_K=20
VECTOR_CANDIDATE_TOP_K=20
TOP_K=5

# ---------- 时效治理（本项目特有）----------
CURRENCY_RERANK_ENABLED=true
CURRENCY_DEFAULT_STATUS_CODE=3
CURRENCY_ALLOW_UNEFFECTIVE=true

# ---------- 检索门控 / 拒答 ----------
RETRIEVAL_GATE_ENABLED=true
RETRIEVAL_SIMILARITY_THRESHOLD=0.55
DOMAIN_ROUTER_ENABLED=false
DOMAIN_ROUTER_HARD_FILTER=false

# ---------- 生成层 LLM（SenseNova 商汤）----------
# 2026-09-28 定案：统一使用 sensenova-6.8-flash-lite，**废弃智谱 glm 路线**。
# 理由：① 双后端会让同一份评测跑在不同模型上 → 指标不可比；
#       ② 可复跑对照（scripts/bench_llm_backends.py，6 题 p50）：
#          glm-4.5-flash 32.5s ｜ glm-4-flash 19.4s ｜ sensenova-6.8-flash-lite 4.8s；
#       ③ 商汤条号可精确到"第（二）项"，与 glm-4.5-flash 同级。
# 详见 docs/00-决策记录.md D-24 与 docs/06 第四节。
LLM_BACKEND=sensenova
LLM_MODEL=sensenova-6.8-flash-lite
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# 凭据：只从环境变量读，**不写入任何文件**。
# SENSENOVA_API_KEYS 支持逗号分隔多个 key，自动轮转（遇 429 会换下一个 key）。
#   export SENSENOVA_API_KEYS='sk-aaa,sk-bbb,sk-ccc'
SENSENOVA_API_KEYS=<在此填入你的商汤 API Key，或设同名环境变量>

# 限流与退避（防止频繁 429）
LLM_MIN_INTERVAL_SECONDS=0.5
LLM_BACKOFF_BASE_SECONDS=2.0
LLM_BACKOFF_MAX_SECONDS=30.0
LLM_BACKOFF_JITTER_SECONDS=1.0

# 降级预案：全本地 LLM（需先安装 Ollama + 拉模型）
# LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3:4b

# ---------- 代理（本机有代理会劫持 localhost）----------
NO_PROXY=localhost,127.0.0.1
# 直连 huggingface.co 被阻断，必须走镜像
HF_ENDPOINT=https://hf-mirror.com
